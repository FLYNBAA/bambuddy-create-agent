# BCA provider configuration template.
# Copy into deployment environment/secret manager. Do not commit a populated copy.
# All values below are placeholders, not usable credentials.

# Public origin used only when Meshy public_url input mode is selected.
BCA_PUBLIC_BASE_URL=https://bca.example.invalid

# DeepSeek creative brief and command planner.
DEEPSEEK_API_KEY=<inject-secret>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI-compatible image relay.
IMAGE_API_KEY=<inject-secret>
IMAGE_BASE_URL=https://api.example.invalid/v1
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=high

# Tencent Hunyuan 3D.
TENCENT_SECRET_ID=<inject-secret>
TENCENT_SECRET_KEY=<inject-secret>
TENCENT_REGION=ap-guangzhou

# Meshy multi-color 3MF.
MESHY_API_KEY=<inject-secret>
MESHY_BASE_URL=https://api.meshy.ai
MESHY_MODEL_INPUT_MODE=data_uri

# Native Bambuddy manual spool inventory is used by BCA calibration.
# Leave this unset unless a separate legacy PostgreSQL inventory is intentionally required.
# FILAMENT_DATABASE_URL=
