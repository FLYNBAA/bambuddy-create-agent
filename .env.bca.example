# BCA initial Provider configuration template / BCA 首次启动 Provider 配置模板。
# Environment values are loaded on first start; Agent Services may later persist and hot-reload plaintext values in the Bambuddy database. / 环境变量只提供首次启动值；网页 Agent Services 可以随后将明文值持久化并热加载。
# All values below are placeholders, not usable credentials. / 以下均为占位符，不是可用凭据。

# Public origin used only when Meshy public_url input mode is selected. / 仅在 Meshy 使用 public_url 输入时使用的公开地址。
BCA_PUBLIC_BASE_URL=https://bca.example.invalid

# DeepSeek creative brief and command planner. / DeepSeek 创意补全与命令规划。
DEEPSEEK_API_KEY=<inject-secret>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI-compatible image relay. / OpenAI 兼容图像中转。
IMAGE_API_KEY=<inject-secret>
IMAGE_BASE_URL=https://api.example.invalid/v1
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=high

# Tencent Hunyuan 3D. / 腾讯混元 3D。
TENCENT_SECRET_ID=<inject-secret>
TENCENT_SECRET_KEY=<inject-secret>
TENCENT_REGION=ap-guangzhou

# Meshy multi-color 3MF. / Meshy 多色 3MF。
MESHY_API_KEY=<inject-secret>
MESHY_BASE_URL=https://api.meshy.ai
MESHY_MODEL_INPUT_MODE=data_uri

# Native Bambuddy manual spool inventory is used by BCA calibration. / BCA 校准使用 Bambuddy 原生活动手动耗材。
# Leave this unset unless a separate legacy PostgreSQL inventory is intentionally required. / 除非明确需要旧 PostgreSQL 耗材库，否则保持未设置。
# FILAMENT_DATABASE_URL=
